<Project>
	<PropertyGroup Label="Dependency versions">
		<RoslynVersion>5.9.0</RoslynVersion>
		<TUnitVersion>1.83.0</TUnitVersion>
		<PurviewSGFVersion>2.0.0</PurviewSGFVersion>
		<OpenTelemetryVersion>1.20.1</OpenTelemetryVersion>
		<!--
			The lowest framework line this repository supports is net10.0, so every Microsoft.Extensions.*,
			System.Diagnostics.DiagnosticSource and ASP.NET Core package stays on the .NET 10 line, never the
			.NET 11 one. A library that references these packages hands its references on to consumers;
			pinning the 11.x line would raise their floor to .NET 11 for no benefit. The .NET 11 packages are
			used only where the consumer itself targets net11.0 (see the "Packed consumers" group below).

			Two families move independently, so each is one property and cannot be bumped halfway:
			  * DotnetRuntimeVersion  - versioned 10.0.<patch> with the runtime; the patch is the latest
			                            net10.0 servicing release.
			  * MSExtensionVersion    - dotnet/extensions, versioned 10.<minor>.0.

			DependencyFloor is the switch that proves the lower bound instead of assuming it: the ordinary
			restore takes the latest patch of the supported line, and `-p:DependencyFloor=true` drops both
			families to the oldest version this generator's code and tests compile and pass against
			(`just test-floor`). A floor nobody builds against is a guess.
		-->
		<DependencyFloor Condition="'$(DependencyFloor)' == ''">false</DependencyFloor>
		<DotnetRuntimeVersion Condition="'$(DependencyFloor)' != 'true'">10.0.15</DotnetRuntimeVersion>
		<DotnetRuntimeVersion Condition="'$(DependencyFloor)' == 'true'">10.0.0</DotnetRuntimeVersion>
		<MSExtensionVersion Condition="'$(DependencyFloor)' != 'true'">10.11.0</MSExtensionVersion>
		<MSExtensionVersion Condition="'$(DependencyFloor)' == 'true'">10.0.0</MSExtensionVersion>
	</PropertyGroup>
	<PropertyGroup Label="Restore policy">
		<!--
			Audit the whole graph, not only the packages declared here: this repository ships a compiler-host
			assembly, so a vulnerable transitive dependency is one it hands to every consumer's build. The
			.NET 11 SDK defaults this to `direct`. The SDK already turns on transitive pinning
			(CentralPackageTransitivePinningEnabled=true), so a transitive uplift is visible here as a
			deliberate override rather than only in the resolved graph.
		-->
		<NuGetAuditMode>all</NuGetAuditMode>
	</PropertyGroup>
	<ItemGroup>
		<PackageVersion Include="Purview.SourceGeneratorFramework" Version="$(PurviewSGFVersion)" />
		<PackageVersion Include="Purview.SourceGeneratorFramework.Testing.TUnit" Version="$(PurviewSGFVersion)" />
		<PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100" />
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="$(RoslynVersion)" />
		<PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="$(RoslynVersion)" />
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="$(RoslynVersion)" />
		<PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="$(RoslynVersion)" />
		<PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="$(RoslynVersion)" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(DotnetRuntimeVersion)" />
		<PackageVersion Include="Microsoft.Extensions.Logging" Version="$(DotnetRuntimeVersion)" />
		<PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="$(DotnetRuntimeVersion)" />
		<PackageVersion Include="Microsoft.Extensions.Telemetry.Abstractions" Version="$(MSExtensionVersion)" />
		<PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="$(DotnetRuntimeVersion)" />
	</ItemGroup>
	<ItemGroup Label="Testing">
		<PackageVersion Include="TUnit" Version="$(TUnitVersion)" />
		<PackageVersion Include="TUnit.Mocks" Version="$(TUnitVersion)" />
		<PackageVersion Include="Bogus" Version="35.6.5" />
		<PackageVersion Include="Purview.Skills.Testing" Version="2.0.0" />
		<PackageVersion Include="CliWrap" Version="3.10.5" />
	</ItemGroup>
	<ItemGroup Label="Samples">
		<PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="$(DotnetRuntimeVersion)" />
		<PackageVersion
			Include="Microsoft.Extensions.DependencyInjection.Abstractions"
			Version="$(DotnetRuntimeVersion)"
		/>
		<PackageVersion Include="Microsoft.Extensions.Diagnostics" Version="$(DotnetRuntimeVersion)" />
		<PackageVersion Include="Microsoft.Extensions.Diagnostics.Abstractions" Version="$(DotnetRuntimeVersion)" />
		<PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(DotnetRuntimeVersion)" />
		<PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="$(MSExtensionVersion)" />
		<PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="$(MSExtensionVersion)" />
		<PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="$(OpenTelemetryVersion)" />
		<PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="$(OpenTelemetryVersion)" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="$(OpenTelemetryVersion)" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.GrpcNetClient" Version="1.18.0-beta.1" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="$(OpenTelemetryVersion)" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.Process" Version="1.18.0-rc.1" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="$(OpenTelemetryVersion)" />
		<PackageVersion Include="Scalar.AspNetCore" Version="2.17.3" />
		<PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
		<PackageVersion Include="ErrorOr" Version="2.1.1" />
	</ItemGroup>
	<!--
		No project in the repository references these: scripts/test-packed-consumers.ps1 reads them and hands them to
		the consumers in scripts/packed-consumers/, which build outside the repository with central package
		management off. They live here so the versions are bumped with everything else. The consumers target net11.0,
		so these follow the .NET 11 SDK that global.json selects, and must share one version. The consumers'
		Microsoft.Extensions.* packages (DependencyInjection, Diagnostics - for services.AddTracing() - and Logging) use
		the same version.
	-->
	<ItemGroup Label="Packed consumers">
		<PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
		<PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="11.0.0" />
	</ItemGroup>
</Project>
