<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<!-- Use ProjectReference for local development -->
		<ProjectReference
			Include="..\..\..\src\src\SourceGenerator\SourceGenerator.csproj"
			OutputItemType="Analyzer"
			ReferenceOutputAssembly="false"
		/>
		<!-- The generator references the Purview.SourceGeneratorFramework runtime; a project-reference
		     analyzer only propagates the generator assembly, so ship the runtime beside it explicitly. -->
		<Analyzer
			Include="..\..\..\src\src\SourceGenerator\bin\$(Configuration)\netstandard2.0\Purview.SourceGeneratorFramework.dll"
		/>
		<Analyzer
			Include="..\..\..\src\src\SourceGenerator\bin\$(Configuration)\netstandard2.0\Purview.SourceGeneratorFramework.Shared.dll"
		/>
		<ProjectReference Include="..\SampleApp.ServiceDefaults\SampleApp.ServiceDefaults.csproj" />
		<ProjectReference Include="..\SampleApp.Shared\SampleApp.Shared.csproj" />
	</ItemGroup>
	<ItemGroup>
		<Using Include="ErrorOr" />
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
			<_Parameter1>DynamicProxyGenAssembly2</_Parameter1>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
			<_Parameter1>SampleApp.APIService.UnitTests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>
</Project>
