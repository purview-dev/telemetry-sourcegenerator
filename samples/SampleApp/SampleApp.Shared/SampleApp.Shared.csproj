<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<!-- This library ships tracing and metrics but no logging, so the logging support (and its
		     dependency on Microsoft.Extensions.Logging.Abstractions) is excluded. -->
		<DefineConstants>$(DefineConstants);EXCLUDE_PURVIEW_TELEMETRY_LOGGING</DefineConstants>
	</PropertyGroup>
	<ItemGroup>
		<!-- The generated metric class takes an IMeterFactory, and the generated dependency-injection
		     extension needs the service-collection abstractions. -->
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Diagnostics.Abstractions" />
	</ItemGroup>
	<ItemGroup>
		<!-- The generator and its Purview.SourceGeneratorFramework runtime dependencies are resolved
		     from the generator's build output via the SDK's GetSourceGeneratorAnalyzerFiles target,
		     always built with the referencing configuration, so no bin/ paths are hard-coded. -->
		<ProjectReference
			Include="..\..\..\src\src\SourceGenerator\SourceGenerator.csproj"
			OutputItemType="Analyzer"
			ReferenceOutputAssembly="false"
		/>
	</ItemGroup>
</Project>
