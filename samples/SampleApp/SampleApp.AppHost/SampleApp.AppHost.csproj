<Project Sdk="Aspire.AppHost.Sdk">
	<PropertyGroup>
		<!--
			The AppHost targets net10.0. Aspire AppHosts cannot cross-target, so the framework is pinned
			(and TargetFrameworks cleared) in this sample's Directory.Build.props - see the comment there for
			why an AppHost SDK build fails with MSB4036 when the project is cross-targeting.
		-->
		<!-- The AppHost only orchestrates project resources; nothing in its compilation declares the
		     SampleApp namespace, so the SDK's namespace-prefix global using is not resolvable. -->
		<AutoIncludeUsings>false</AutoIncludeUsings>
		<!-- ASPIRE010: the AppHost runs through the Aspire CLI, so the CLI-bundle build integration
		     is not needed and its advisory is suppressed. -->
		<NoWarn>$(NoWarn);ASPIRE010;</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\SampleApp.APIService\SampleApp.APIService.csproj" />
		<ProjectReference Include="..\SampleApp.Web\SampleApp.Web.csproj" />
	</ItemGroup>
</Project>
