<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
	</PropertyGroup>

	<ItemGroup>
		<!-- The generator and its Purview.SourceGeneratorFramework runtime dependencies are resolved
		     from the generator's build output via the SDK's GetSourceGeneratorAnalyzerFiles target,
		     always built with the referencing configuration, so no bin/ paths are hard-coded. -->
		<ProjectReference
			Include="..\..\..\src\src\SourceGenerator\SourceGenerator.csproj"
			OutputItemType="Analyzer"
			ReferenceOutputAssembly="false"
		/>
		<ProjectReference Include="..\SampleApp.ServiceDefaults\SampleApp.ServiceDefaults.csproj" />
		<ProjectReference Include="..\SampleApp.Shared\SampleApp.Shared.csproj" />
	</ItemGroup>
</Project>
