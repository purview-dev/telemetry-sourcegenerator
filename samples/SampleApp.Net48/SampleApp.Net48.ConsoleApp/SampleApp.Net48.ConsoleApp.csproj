<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
	</PropertyGroup>

	<ItemGroup>
		<!-- Build-order only dependency for local development — switch to PackageReference for production use.
		     The generator is registered as an analyzer explicitly below so a single, configuration-consistent
		     assembly is loaded (the .NET SDK strips Configuration from analyzer project references, which
		     would otherwise load both Debug and Release copies and run the generator twice). -->
		<ProjectReference
			Include="..\..\..\src\src\SourceGenerator\SourceGenerator.csproj"
			ReferenceOutputAssembly="false"
		/>
		<!-- The generator references the Purview.SourceGeneratorFramework runtime; a project-reference
		     analyzer only propagates the generator assembly, so ship the generator and its runtime
		     beside it explicitly. -->
		<Analyzer Include="..\..\..\src\src\SourceGenerator\bin\$(Configuration)\netstandard2.0\Purview.Telemetry.SourceGenerator.dll" />
		<Analyzer Include="..\..\..\src\src\SourceGenerator\bin\$(Configuration)\netstandard2.0\Purview.SourceGeneratorFramework.dll" />
		<Analyzer Include="..\..\..\src\src\SourceGenerator\bin\$(Configuration)\netstandard2.0\Purview.SourceGeneratorFramework.Shared.dll" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" />
		<PackageReference Include="System.Diagnostics.DiagnosticSource" />
	</ItemGroup>
</Project>
