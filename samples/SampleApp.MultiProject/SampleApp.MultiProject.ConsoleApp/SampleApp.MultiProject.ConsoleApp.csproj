<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
	</PropertyGroup>

	<ItemGroup>
		<!-- The generator and its Purview.SourceGeneratorFramework runtime dependencies are resolved
		     from the generator's build output via the SDK's GetSourceGeneratorAnalyzerFiles target,
		     always built with the referencing configuration, so no bin/ paths are hard-coded.
		     Switch to a PackageReference for production use. -->
		<ProjectReference
			Include="..\..\..\src\src\SourceGenerator\SourceGenerator.csproj"
			OutputItemType="Analyzer"
			ReferenceOutputAssembly="false"
		/>
		<!-- Ordering is the only telemetry-owning project referenced directly; Payments and
		     Notifications arrive transitively, and are aggregated all the same. -->
		<ProjectReference Include="..\SampleApp.MultiProject.Ordering\SampleApp.MultiProject.Ordering.csproj" />
		<ProjectReference Include="..\SampleApp.MultiProject.Observability\SampleApp.MultiProject.Observability.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
		<PackageReference Include="Microsoft.Extensions.Diagnostics" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" />
	</ItemGroup>
</Project>
