<Project>
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<NamespacePrefix>SampleApp.MultiProject</NamespacePrefix>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<!--
			This comes from Purview.BuildSdk where we auto include the
			telemetry... the samples consume the local generator via analyzer
			ProjectReference, so the published package is excluded here.
		-->
		<ExcludePurviewTelemetry>true</ExcludePurviewTelemetry>
		<!--
			CA1303: console sample — no resource table needed for literal strings.
		-->
		<NoWarn>$(NoWarn);CA1303;</NoWarn>
	</PropertyGroup>

	<Import Sdk="Purview.BuildSdk" Project="Sdk.props" />

	<PropertyGroup>
		<!--
			Purview.BuildSdk resolves its curated 'Current' target set (net10.0;net11.0) into TargetFrameworks
			whenever that property is empty at the import above: it detects a project's own TargetFramework
			declaration from the project file, never from this file. Clear it afterwards so restore and build
			agree on one framework instead of restore resolving assets for two.
		-->
		<TargetFrameworks></TargetFrameworks>
	</PropertyGroup>
</Project>
