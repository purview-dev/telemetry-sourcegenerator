<Solution>
	<Folder Name="/Solution Items/">
		<File Path="../../global.json" />
		<File Path="../../Directory.Packages.props" />
		<File Path="Directory.Build.props" />
		<File Path="README.md" />
	</Folder>
	<!-- Each project consumes the source generator as an analyzer ProjectReference. Including the
	     generator projects in the solution gives the solution-configuration blob explicit mappings,
	     so the analyzer resolves from a single, configuration-consistent output (the .NET SDK would
	     otherwise default the reference to Debug when building in Release and load both copies). -->
	<Folder Name="/generator/">
		<Project Path="../../src/src/SourceGenerator/SourceGenerator.csproj" />
		<Project Path="../../src/src/SourceGenerator.Refactorings/SourceGenerator.Refactorings.csproj" />
	</Folder>
	<Project Path="SampleApp.MultiProject.Observability/SampleApp.MultiProject.Observability.csproj" />
	<Project Path="SampleApp.MultiProject.Notifications/SampleApp.MultiProject.Notifications.csproj" />
	<Project Path="SampleApp.MultiProject.Payments/SampleApp.MultiProject.Payments.csproj" />
	<Project Path="SampleApp.MultiProject.Ordering/SampleApp.MultiProject.Ordering.csproj" />
	<Project Path="SampleApp.MultiProject.ConsoleApp/SampleApp.MultiProject.ConsoleApp.csproj" />
</Solution>
