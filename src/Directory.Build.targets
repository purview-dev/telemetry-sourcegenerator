<Project>
	<Import Sdk="Purview.BuildSdk" Project="Sdk.targets" />

	<!-- =====================================================================
	     REPOSITORY SKILLS PACKAGING (interim shim)

	     Authored skills live at the repository root in 'skills/<name>/', not in
	     'Sdk/.agents/skills/'. The skills CLI only discovers skills at a root
	     'skills/' folder, and '.agents/' is gitignored here - so it is absent
	     from a git clone and cannot be the published source.

	     Packing them into the package's '.agents/skills/' keeps the existing
	     mirror working for consumers, unchanged.

	     This is a shim because global.json pins Purview.BuildSdk 1.0.5, which
	     does not yet have the SDK-side equivalent. It deliberately implements
	     the same property name the SDK uses, so adopting the newer SDK is:
	       1. set PurviewPackRepositorySkills=true on the same projects, and
	       2. delete this block.
	     Nothing else changes, and the two cannot double-pack: the SDK's target
	     is gated on PurviewPackRepositorySkills, which is not set here.
	     ===================================================================== -->
	<PropertyGroup Condition="'$(PurviewSkillsToPack)' != ''">
		<PurviewSkillsSourceFolder Condition="'$(PurviewSkillsSourceFolder)' == ''"
			>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'skills'))</PurviewSkillsSourceFolder>
		<TargetsForTfmSpecificContentInPackage
			Condition="!$([System.String]::Copy(';$(TargetsForTfmSpecificContentInPackage);').Contains(';IncludeRepositorySkillsInPackage;'))"
			>$(TargetsForTfmSpecificContentInPackage);IncludeRepositorySkillsInPackage</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>

	<Target
		Name="IncludeRepositorySkillsInPackage"
		Condition="'$(PurviewSkillsToPack)' != '' AND Exists('$(PurviewSkillsSourceFolder)') AND ('$(DefaultTargetFramework)' == '' OR '$(TargetFramework)' == '$(DefaultTargetFramework)')"
		Label="Packs the named repository-root skills into the package's .agents/skills/ folder."
	>
		<ItemGroup>
			<_RepositorySkillToPack Include="$(PurviewSkillsToPack)" />
			<_RepositorySkillFile Include="$(PurviewSkillsSourceFolder)%(_RepositorySkillToPack.Identity)/**/*">
				<SkillName>%(_RepositorySkillToPack.Identity)</SkillName>
			</_RepositorySkillFile>
		</ItemGroup>

		<Error
			Condition="!Exists('$(PurviewSkillsSourceFolder)%(_RepositorySkillToPack.Identity)')"
			Text="PurviewSkillsToPack names '%(_RepositorySkillToPack.Identity)', but '$(PurviewSkillsSourceFolder)%(_RepositorySkillToPack.Identity)' does not exist. A renamed or deleted skill would otherwise be dropped from the package silently."
		/>

		<!-- Second step so only one item list is in play: building the path in the group above would
		     mix batching over _RepositorySkillToPack with the new item's own RecursiveDir, and
		     setting it straight onto TfmSpecificPackageFile batches over that whole list - which
		     already holds this package's analyzer assemblies - and fails with MSB4096. -->
		<ItemGroup>
			<_RepositorySkillPackageFile Include="@(_RepositorySkillFile)">
				<PackagePath>.agents/skills/%(SkillName)/$([System.String]::Copy('%(RecursiveDir)').Replace(&quot;\&quot;, &quot;/&quot;))%(Filename)%(Extension)</PackagePath>
			</_RepositorySkillPackageFile>
			<TfmSpecificPackageFile Include="@(_RepositorySkillPackageFile)" />
		</ItemGroup>

		<!-- The pre-migration package carried a .gitignore in each skill folder, written by the SDK
		     from Sdk/.agents. Keep shipping it so a consumer sees no change: the folder is wholly
		     owned by the package, so a blanket ignore there cannot hide anything they authored. -->
		<PropertyGroup>
			<_RepositorySkillGitIgnoreRoot>$([MSBuild]::NormalizeDirectory('$(IntermediateOutputPath)', '_PurviewSkillGitIgnores'))</_RepositorySkillGitIgnoreRoot>
		</PropertyGroup>
		<WriteLinesToFile
			File="$(_RepositorySkillGitIgnoreRoot)%(_RepositorySkillToPack.Identity)/.gitignore"
			Lines="# Ignore all files;*;;# Don't ignore directories, so Git can traverse them;!*/;;# This file is mirrored from a NuGet package, so ignore it too;/.gitignore"
			Overwrite="true"
			WriteOnlyWhenDifferent="true"
		/>
		<ItemGroup>
			<_RepositorySkillGitIgnoreFile Include="$(_RepositorySkillGitIgnoreRoot)%(_RepositorySkillToPack.Identity)/.gitignore">
				<PackagePath>.agents/skills/%(_RepositorySkillToPack.Identity)/.gitignore</PackagePath>
			</_RepositorySkillGitIgnoreFile>
			<TfmSpecificPackageFile Include="@(_RepositorySkillGitIgnoreFile)" />
		</ItemGroup>
	</Target>
</Project>
