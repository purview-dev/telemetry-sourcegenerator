<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks>net48;net8.0;net9.0;net10.0</TargetFrameworks>
		<LangVersion>14.0</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<Optimize>true</Optimize>
		<!-- BenchmarkDotNet method names are underscore-separated by convention, and BenchmarkDotNet
		     only discovers and generates hosts for public benchmark types (CA1515). -->
		<NoWarn>$(NoWarn);CA1707;CA1515</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<!--
			This project sits outside src/, so it does not import Purview.BuildSdk, which is what
			normally asks a referenced Roslyn component for its analyzer files. A plain
			OutputItemType="Analyzer" reference would hand Roslyn the generator's *unmerged* bin
			assembly, which still needs a loose Purview.SourceGeneratorFramework.dll beside it.

			Targets="GetSourceGeneratorAnalyzerFiles" asks the generator for the analyzer artifact
			itself instead: the merged, self-contained generator (the same shape the package ships),
			which carries the framework internally and has no runtime dependencies to probe for. That
			holds for every build mode, including BenchmarkDotNet's UseSharedCompilation=false host
			build. No version of Purview.SourceGeneratorFramework ships a separate
			Purview.SourceGeneratorFramework.Shared.dll, so there is nothing else to load.

			BenchmarkDotNet's autogenerated host build passes ArtifactsPath/OutDir/OutputPath as
			global properties. They are stripped so the generator keeps building to its normal
			output path rather than a stray folder relative to the generator project.
		-->
		<ProjectReference
			Include="..\..\src\src\SourceGenerator\SourceGenerator.csproj"
			Targets="GetSourceGeneratorAnalyzerFiles"
			OutputItemType="Analyzer"
			ReferenceOutputAssembly="false"
			GlobalPropertiesToRemove="ArtifactsPath;OutDir;OutputPath"
		/>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.4" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.4" />
		<PackageReference Include="Microsoft.Extensions.Telemetry.Abstractions" Version="10.4.0" />
	</ItemGroup>
</Project>
